# ── Site ────────────────────────────────────────────────────────────────────
# Canonical production URL. Used for canonical/OG/sitemap. Override on Vercel
# once you know the real domain (Project → Settings → Environment Variables).
# SITE_URL=https://yurifp-portfolio.vercel.app

# ── Email (contact form — Astro Action) ─────────────────────────────────────
# Resend API key. Without it, the action runs in dev mode: submissions are
# logged server-side and the form still returns success with an honest note.
# https://resend.com/api-keys
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Where contact submissions are delivered (defaults to dev.yurifpaulo@gmail.com).
# RESEND_TO=dev.yurifpaulo@gmail.com

# NOTE: with a free Resend account you can only send from `onboarding@resend.dev`
# to your own account email. Verify a domain (or add the gmail) to send anywhere.

# ── Views counter (Upstash Redis) ────────────────────────────────────────────
# Redis REST credentials from https://console.upstash.com (REST API section).
# Without them, /api/views answers { live: false } and counters render an em dash.
# UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
# UPSTASH_REDIS_REST_TOKEN=AXXXXXXXXXXXXXX

# ── Static mirror (set by the GitHub Pages workflow, rarely needed locally) ──
# Points the static mirror's counters at the live Vercel API (CORS is open).
# PUBLIC_VIEWS_API=https://yurifp-portfolio.vercel.app
