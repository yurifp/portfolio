---
import '../styles/global.css';
import FieldChrome from '../components/FieldChrome.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${site.name} — ${site.role}`,
  description = 'Portfolio of Yuri Ferreira Paulo — software engineer building interfaces where engineering meets graphic art.',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  jobTitle: 'Software Engineer',
  description,
  email: `mailto:${site.email}`,
  url: Astro.site?.toString(),
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Salvador',
    addressRegion: 'Bahia',
    addressCountry: 'BR',
  },
  sameAs: [
    'https://github.com/yurifp',
    'https://www.linkedin.com/in/yuri-ferreira-paulo-86877a183',
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#070210" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.png', Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL('/og.png', Astro.site)} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-theme="void">
    <a
      href="#main"
      class="fixed left-4 top-4 z-[400] -translate-y-24 bg-lime px-3 py-2 text-xs font-medium text-void transition-transform focus:translate-y-0"
    >
      Skip to content
    </a>
    <FieldChrome />
    <main id="main">
      <slot />
    </main>
    <script>
      import { initField } from '../scripts/main';
      initField();
    </script>
  </body>
</html>
