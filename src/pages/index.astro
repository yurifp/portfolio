---
export const prerender = true;

import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Marquee from '../components/Marquee.astro';
import Snapshots from '../components/Snapshots.astro';
import WorkedAt from '../components/WorkedAt.astro';
import Footer from '../components/Footer.astro';
---

<Base>
  <Hero />
  <Stats />
  <Marquee
    items={['SELECTED WORK', 'CASE STUDIES', 'WEB EXPERIENCES', '3D & MOTION', 'APP INTERFACES', 'TYPE & GRID']}
  />
  <Snapshots />
  <WorkedAt />
  <Footer />
</Base>

<script>
  import { mountHeroField } from '../scripts/hero-field';
  import { mountPortrait } from '../scripts/portrait';

  const canvas = document.querySelector<HTMLCanvasElement>('[data-hero-field]');
  if (canvas) mountHeroField(canvas);

  const portrait = document.querySelector<HTMLCanvasElement>('[data-portrait]');
  if (portrait) mountPortrait(portrait);
</script>
