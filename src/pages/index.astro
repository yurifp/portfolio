---
// The page is pure content (islands hydrate client-side) — always static,
// in both deploy targets. Only /api/* and /_actions/* run on-demand.
export const prerender = true;

import Base from '../layouts/Base.astro';
import Story from '../components/Story.astro';
import Work from '../components/Work.astro';
import Experience from '../components/Experience.astro';
import StackLines from '../components/StackLines.astro';
import About from '../components/About.astro';
import Telemetry from '../components/Telemetry.astro';
import Contact from '../components/Contact.astro';

const title = 'Yuri Ferreira Paulo — Software Engineer';
const description =
  'Software engineer with six years of production front-end and the backend proof running on this page: a typed Astro Action, Redis view counters, one codebase deployed twice. Two-time NASA Space Apps global nominee.';
---

<Base title={title} description={description}>
  <Story />
  <Work />
  <Experience />
  <StackLines />
  <About />
  <Telemetry />
  <Contact />
</Base>
