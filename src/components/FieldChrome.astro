---
/*
  FieldChrome — every fixed layer of the page in one place:
  nav, menu overlay, cursor, preloader, progress rail, noise.
*/
import { site, socials } from '../data/site';
---

<!-- nav — one axis: logo left, cluster right (at the safe edge), top = gutter.
     Color = --hud-ink, scrubbed by the film (light on void, ink on lime). -->
<nav class="fixed top-0 inset-x-0" style="z-index: var(--z-hud); color: var(--hud-ink);">
  <div class="flex items-center justify-between" style="padding: var(--gutter) var(--gutter) 0 0;">
    <a href="/" class="flex items-center gap-3 group" style="margin-left: var(--gutter);" aria-label="Home">
      <span class="font-heading font-semibold text-[1.05rem] tracking-[0.02em] uppercase">{site.wordmark}</span>
    </a>
    <div class="flex items-center gap-[1.6rem]" style="padding-right: var(--rail-lane);">
      <button class="sound" data-sound-btn role="switch" aria-checked="false">
        <span class="sound__dot" aria-hidden="true"></span>
        <span class="sound__label">SOUND —</span>
        <span class="sound__state" aria-hidden="true">
          <span data-s="off">OFF</span>
          <span data-s="on">ON</span>
        </span>
      </button>
      <div class="mono-tiny text-right leading-[1.7] hidden sm:block">
        <div>{site.location.city} / <span data-clock>--:--</span></div>
        <div style="opacity: 0.6;">{site.location.coords}</div>
      </div>
      <button data-menu-btn aria-expanded="false" class="mono-tiny flex items-center gap-2 px-[0.7rem] py-[0.4rem] min-h-[24px] box-border hover:bg-white hover:text-black transition-colors" style="border: 1px solid color-mix(in srgb, var(--hud-ink) 40%, transparent);">
        Menu
      </button>
    </div>
  </div>
</nav>

<!-- menu overlay -->
<div class="menu-overlay" role="dialog" aria-label="Menu">
  <div class="h-full flex flex-col justify-between px-[1.6rem] pt-[5.5rem] pb-[1.4rem]">
    <nav class="flex flex-col gap-[0.4rem] overflow-hidden">
      <a href="/" data-menu-stagger class="font-heading font-medium text-[3.2rem] leading-[1.02] tracking-[-0.02em] uppercase text-ink hover:text-lime transition-colors">About</a>
      <a href="/work" data-menu-stagger class="font-heading font-medium text-[3.2rem] leading-[1.02] tracking-[-0.02em] uppercase text-ink hover:text-lime transition-colors">Work</a>
    </nav>
    <div class="flex items-end justify-between gap-8">
      <div class="overflow-hidden">
        <p class="mono-label mb-3" data-menu-stagger>Connect</p>
        <ul class="space-y-[0.55rem]">
          {socials.menu.map((s) => (
            <li data-menu-stagger>
              <a href={s.url} class="mono-tiny text-dim hover:text-ink transition-colors inline-block py-[0.4rem] min-h-[24px] box-border">
                <span class="text-faint mr-2">{s.n}</span>{s.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
      <p class="mono-tiny text-faint" data-menu-stagger>{site.copyright}</p>
    </div>
  </div>
</div>

<!-- cursor -->
<div class="cursor-root" aria-hidden="true">
  <div class="cursor-dot"></div>
  <div class="cursor-label"></div>
</div>

<!-- preloader -->
<div class="preloader" aria-hidden="true">
  <div>
    <p class="mono-tiny text-dim mb-2">LOADING FIELD</p>
    <p class="mono-tiny text-faint">{site.wordmark}</p>
  </div>
  <p class="preloader__pct">0%</p>
</div>

<!-- progress rail — 3-row grid INSIDE the exclusive lane:
     NASA top · % + track + SCROLL middle · SALVADOR bottom -->
<div class="progress-rail" aria-hidden="true">
  <span class="mono-tiny rail-slot">NASA × 2 NOMINEE</span>
  <div class="rail-mid flex flex-col items-center" style="gap: 0.6rem;">
    <span class="mono-tiny" data-progress-pct style="font-variant-numeric: tabular-nums; width: 3ch; text-align: center;">0%</span>
    <div class="progress-rail__track"><div class="progress-rail__fill"></div></div>
    <span class="mono-tiny rail-scroll">SCROLL</span>
  </div>
  <span class="mono-tiny rail-slot">SALVADOR — BR</span>
</div>

<!-- grain -->
<div class="noise-layer" aria-hidden="true"></div>

<!-- rotate notice (mobile landscape only) -->
<div class="landscape-notice" role="status">
  <span class="font-heading text-[2.4rem] leading-none" style="color: #9df133;">⟳</span>
  <p class="mono-tiny" style="color: #f5f0eb;">This experience is built for portrait</p>
  <p class="mono-tiny text-dim">Please rotate your device</p>
</div>
