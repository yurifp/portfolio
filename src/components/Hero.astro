---
import { site, bio } from '../data/site';
import ConstellationGrid from './ui/constellation-grid';

/* contact split across the column grid, reference-style */
const phoneCols = ['+55', '71', '99', 'XXX', 'XXXX'];
---
<section class="relative h-full min-h-0 flex flex-col" id="about" style="padding: var(--gutter);">
  <!-- WebGL signal field -->
  <div class="absolute inset-0 pointer-events-none" style="z-index: var(--z-ghost);" aria-hidden="true">
    <ConstellationGrid client:load density={36} />
  </div>

  <!-- full-height column grid (content layer) -->
  <div class="absolute inset-0 pointer-events-none hidden md:grid md:grid-cols-4" style="z-index: var(--z-ghost);" aria-hidden="true">
    <div class="hairline-v"></div>
    <div class="hairline-v"></div>
    <div class="hairline-v"></div>
    <div></div>
  </div>

  <!-- giant country code — option (a): fully inside, quiet zone, 5% -->
  <span
    class="font-heading font-bold absolute select-none hidden lg:block pointer-events-none"
    style="font-size: min(10vw, 20vh); line-height: 1; letter-spacing: -0.06em; color: rgba(245,240,235,0.05); right: var(--safe-right); top: 16%; z-index: var(--z-ghost);"
    data-scramble
    data-choreo="br"
    aria-label="BR — Brazil"
  >BR</span>

  <!-- tiny red squares (decorative pixels — the only red) -->
  <span class="absolute w-[8px] h-[8px] bg-ember pointer-events-none" style="top: 34%; left: var(--gutter); z-index: var(--z-hud);" data-choreo="meta" aria-hidden="true"></span>
  <span class="absolute w-[8px] h-[8px] bg-ember pointer-events-none hidden md:block" style="bottom: 30%; right: 40%; z-index: var(--z-hud);" data-choreo="meta" aria-hidden="true"></span>

  <!-- corner microcopy (top edge = gutter) -->
  <p class="mono-tiny absolute text-dim pointer-events-none" style="top: var(--gutter); left: var(--gutter); z-index: var(--z-hud);" data-choreo="meta">PORTFOLIO<br />©2026</p>
  <p class="mono-tiny absolute text-dim text-right hidden sm:block pointer-events-none" style="top: var(--gutter); right: var(--safe-right); z-index: var(--z-hud);" data-choreo="meta">
    {site.born}<br />{site.role.toUpperCase()}
  </p>

  <!-- lane labels — one per slot, pinned to the lane's ends -->
  <div class="lane-labels" data-choreo="meta" aria-hidden="true">
    <span>NASA ×2 NOMINEE</span>
  </div>
  <div class="lane-labels lane-labels--bottom" data-choreo="meta" aria-hidden="true">
    <span>SALVADOR — BR</span>
  </div>

  <!-- middle zone: bio left · portrait right (at the safe edge) -->
  <div class="hero-middle relative grid md:grid-cols-[1fr_auto] items-center gap-[2.5rem] flex-1 min-h-0 pt-[calc(var(--gutter)*2)] pb-[2rem]" style="z-index: var(--z-content);">
    <div class="max-w-[44ch]" data-choreo="bio">
      <!-- one line per paragraph in source: JSX strips newline
           whitespace around inline elements — spaces must be explicit -->
      <p class="mono-tiny bio-lead mb-[14px]" style="color: var(--color-lime);" data-fade data-delay={0.15}>{bio.lead}</p>
      <div class="bio-paras space-y-[1rem]" style="font-size: var(--fs-body); line-height: 1.5; color: var(--color-dim);">
        <p data-split="words">{'I\'m a developer who treats code as a visual — the browser is my canvas.'}</p>
        <p data-split="words">{'Nothing holds my attention like the space where engineering meets '}<em class="italic" style="color: var(--color-violet);">{'graphic art.'}</em></p>
        <p data-split="words">{'If I ever cash out, I open a '}<span style="color: var(--color-lime);">{'<studio-lab/>'}</span>{' where young builders prototype the ideas nobody will fund yet.'}</p>
      </div>
      <p class="mono-tiny bio-avail mt-[18px]" style="color: var(--color-lime);" data-avail data-fade data-delay={0.45}>{bio.available}</p>
    </div>

    <div class="md:justify-self-end ticks" data-cursor="HELLO" style="margin-right: 16px; width: clamp(180px, 12vw, 320px);">
      <div data-choreo="portrait" data-fade data-delay={0.3}>
        <canvas data-portrait class="block w-full h-auto"></canvas>
        <p class="mono-tiny text-faint mt-2 flex justify-between w-full"><span>PORTRAIT—DITHER</span><span>BAYER 8×8</span></p>
      </div>
    </div>

    <!-- scroll cue — lives in the empty gap between bio and portrait:
        the bottom strip is fully owned by the footer band + badge -->
    <div class="absolute hidden md:flex flex-col items-center gap-1 pointer-events-none" style="left: 52%; bottom: 1rem; z-index: var(--z-hud);" data-choreo="meta">
      <span class="mono-tiny text-dim">Scroll down</span>
      <span class="block w-px h-[2.2rem] bg-gradient-to-b from-ink/40 to-transparent"></span>
    </div>
  </div>

  <!-- giant name + footer band (base edge = gutter) -->
  <div class="relative" style="z-index: var(--z-content); padding-bottom: max(3vh, var(--gutter));" data-choreo="name">
    <h1
      class="font-heading uppercase"
      style="font-weight: 300; font-size: var(--fs-name); line-height: 0.88; letter-spacing: -0.02em; color: #fff;"
      data-hero-name
    >
      <span data-split="chars" class="block">Yuri</span>
      <span data-split="chars" class="block" style="margin-left: 0.9em;">Ferreira</span>
    </h1>

    <!-- footer band: one baseline, tag starts at the 50% guide line -->
    <div class="relative flex items-end justify-between gap-[1.4rem] mt-[1.2rem]">
      <div class="flex flex-wrap gap-x-[1.4rem] gap-y-1">
        {bio.tags.map((t, i) => (
          <span class="mono-tiny text-dim" data-fade data-delay={0.1 + i * 0.08}>— {t}</span>
        ))}
      </div>

      <!-- notched lime badge, anchored at the center guide -->
      <span
        class="mono-tiny absolute whitespace-nowrap"
        style="left: 50%; bottom: 0; color: #070210; background: var(--color-lime); padding: 0.45em 0.9em; font-weight: 500; clip-path: polygon(0 0, calc(100% - 10px) 0, 100% 100%, 0 100%);"
        data-fade
        data-delay={0.25}
      >{site.role.toUpperCase()} — OPEN FOR WORK</span>

      <!-- contact split across columns (right edge = safe edge) -->
      <div class="hidden md:flex items-end gap-[0.9rem] pr-[calc(var(--rail-lane))]" aria-label="Phone">
        {phoneCols.map((seg, i) => (
          <span class="flex flex-col items-center gap-1" data-fade data-delay={0.35 + i * 0.06}>
            {i === 0 && <span class="block w-px h-[1.1rem]" style="background: var(--color-lime);"></span>}
            <span class="font-heading font-medium" style="font-size: calc(var(--fs-hud) * 1.6); color: var(--ink-now); letter-spacing: 0.04em;">{seg}</span>
          </span>
        ))}
      </div>
    </div>
  </div>

  <!-- scroll cue lives inside the middle zone (see below) -->
</section>
