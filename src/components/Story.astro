---
// Storytelling — 3 beats now: intro, NASA (with the two project boxes),
// full-stack proof. Live telemetry moved down to its own section (Telemetry.astro).
const nasa = [
  {
    name: 'Impacts',
    sub: 'NASA Space Apps 2025 · global nominee',
    stack: 'JavaScript · Three.js · REST',
    projectUrl: '',
    repoUrl: '',
    video: '',
  },
  {
    name: 'GlobeExplorers',
    sub: 'NASA Space Apps 2024 · global nominee',
    stack: 'JavaScript · YOLO · GLOBE API',
    projectUrl: '',
    repoUrl: 'https://github.com/yurifp/GlobeExplorers',
    video: '',
  },
];
---

<div class="story" data-story style="--story-length: 3">
  <div class="story-stage">
    <div class="story-bg" data-story-bg aria-hidden="true"></div>

    <section class="story-beat is-first" data-beat="0" aria-label="Introduction">
      <p class="story-label">Yuri Ferreira Paulo — Salvador, Brazil</p>
      <h2 class="story-title display" data-story-title>Software Engineer</h2>
      <p class="story-text">
        Six years of production front-end. The proof runs on this page — keep
        scrolling.
      </p>
    </section>

    <section class="story-beat" data-beat="1" aria-label="NASA Space Apps Challenge">
      <p class="story-label">Two-time global nominee · NASA Space Apps</p>
      <h2 class="story-title display" data-story-title>Science, rendered <i>live</i>.</h2>

      <div class="nasa-grid">
        {
          nasa.map((p) => (
            <article class="nasa-box" data-nasa-box>
              <div class="nasa-video panel-hatch" aria-label={`${p.name} preview`}>
                {p.video ? (
                  <video src={p.video} muted loop playsinline preload="none" controls={false} />
                ) : (
                  <span class="t-value" style="position:absolute; left:12px; bottom:10px; font-size:10px; color: var(--color-dim);">
                    {p.name.toUpperCase()}
                  </span>
                )}
              </div>
              <div class="nasa-box-body">
                <h3>{p.name}</h3>
                <p class="sub">{p.sub}</p>
                <p class="sub" style="text-transform: none; letter-spacing: 0.02em;">{p.stack}</p>
                <div class="nasa-actions">
                  {p.projectUrl && (
                    <a class="x-btn" href={p.projectUrl} target="_blank" rel="noopener">
                      open project
                    </a>
                  )}
                  {p.repoUrl && (
                    <a class="x-btn" href={p.repoUrl} target="_blank" rel="noopener">
                      repository
                    </a>
                  )}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <section class="story-beat" data-beat="2" aria-label="Full-stack proof">
      <p class="story-label">Full-stack, for real</p>
      <h2 class="story-title display" data-story-title>The backend runs <i>right here</i>.</h2>
      <p class="story-text">
        Typed server actions. Redis counters. One codebase, two deploy targets —
        the live numbers are down below, next to the contact form.
      </p>
    </section>

  </div>
</div>
