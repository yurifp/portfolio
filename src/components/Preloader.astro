---
// Preloader — real progress, not a fake timer:
//   fonts ready ............ 35%
//   window load ............ 25%
//   first WebGL frame ...... 40%   (no-GL fallback: fires after load+fonts)
// Hard cap at 1.8s so the lab LCP never waits on a slow GPU. First visit per
// session only; reduced-motion never shows it (CSS + JS double gate).
---

<div id="preloader" class="preloader" aria-hidden="true">
  <div class="preloader-inner">
    <p class="preloader-name display">Yuri Ferreira Paulo</p>
    <p class="preloader-role">front-end engineer, going full-stack</p>
    <div class="preloader-bar"><span id="preloader-fill"></span></div>
    <p class="t-value preloader-pct" id="preloader-pct">000</p>
  </div>
</div>

<style is:global>
  .preloader {
    position: fixed;
    inset: 0;
    z-index: 60;
    background: var(--color-deep);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .preloader-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .preloader-name {
    font-size: clamp(1.8rem, 4.5vw, 3.1rem);
    color: var(--color-ink);
    margin: 0;
  }
  .preloader-role {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-dim);
    margin: 0 0 14px;
  }
  .preloader-bar {
    width: min(320px, 60vw);
    height: 1px;
    background: var(--color-line);
    overflow: hidden;
  }
  .preloader-bar span {
    display: block;
    height: 100%;
    width: 100%;
    background: var(--color-signal);
    transform-origin: left;
    transform: scaleX(0);
  }
  .preloader-pct {
    font-size: 11px;
    color: var(--color-dim);
    margin: 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .preloader {
      display: none;
    }
  }
</style>

<script>
  import gsap from 'gsap';

  function boot() {
    const root = document.getElementById('preloader');
    if (!root) return;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const seen = sessionStorage.getItem('portfolio:entered');

    if (reduced || seen) {
      root.remove();
      return;
    }

    const fill = root.querySelector<HTMLElement>('#preloader-fill')!;
    const pct = root.querySelector<HTMLElement>('#preloader-pct')!;

    const state = { v: 0 };
    let target = 0;
    const render = () => {
      fill.style.transform = `scaleX(${state.v / 100})`;
      pct.textContent = String(Math.round(state.v)).padStart(3, '0');
    };
    const push = (to: number) => {
      target = Math.max(target, to);
      gsap.to(state, { v: target, duration: 0.6, ease: 'cubic-bezier(0.16, 1, 0.3, 1)', onUpdate: render });
    };

    let done = false;
    const finish = () => {
      if (done) return;
      done = true;
      gsap.to(state, {
        v: 100,
        duration: 0.4,
        ease: 'power1.in',
        onUpdate: render,
        onComplete: () => {
          sessionStorage.setItem('portfolio:entered', '1');
          gsap.to(root, {
            yPercent: -100,
            duration: 0.8,
            ease: 'cubic-bezier(0.83, 0, 0.17, 1)',
            onComplete: () => root.remove(),
          });
        },
      });
    };

    // real signals
    document.fonts.ready.then(() => push(35));
    if (document.readyState === 'complete') push(25);
    else window.addEventListener('load', () => push(25), { once: true });
    window.addEventListener('gl:firstframe', () => push(40), { once: true });

    // no-GL path: once fonts+load are in, the 40% is not coming — complete.
    // Hard cap 1.8s regardless: LCP protection.
    const afterLoad = () => setTimeout(() => target >= 60 && finish(), 250);
    if (document.readyState === 'complete') afterLoad();
    else window.addEventListener('load', afterLoad, { once: true });
    setTimeout(finish, 1800);
  }

  boot();
  // astro:page-load ALSO fires on the first load; astro:after-swap fires only
  // on subsequent ClientRouter navigations — that's when a stale overlay
  // would need cleaning.
  document.addEventListener('astro:after-swap', () => {
    document.getElementById('preloader')?.remove();
  });
</script>
