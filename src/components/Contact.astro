---
const isStatic = process.env.DEPLOY_TARGET === 'github';
const productionUrl = import.meta.env.PUBLIC_VIEWS_API || 'https://yurifp-portfolio.vercel.app';

// The static mirror never imports the actions module — Actions need a server,
// and the mirror renders the "full version" notice instead of a dead form.
// eslint-disable-next-line @typescript-eslint/no-explicit-any
let contactAction: any;
if (!isStatic) {
  contactAction = (await import('astro:actions')).actions.contact;
}
---

<section id="contact" aria-labelledby="contact-title" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-4">
      <h2 id="contact-title" class="display section-title">Contact</h2>
      <p class="text-sm text-dim">the form is a typed Astro Action, validated with Zod</p>
    </div>

    {
      isStatic ? (
        <div class="max-w-2xl rounded-panel border border-line bg-raised/40 p-6">
          <p class="text-ink">
            You are on the static mirror of this site. The contact form and the live
            counters need a server, so they run on the full deployment instead of
            pretending to work here.
          </p>
          <a
            href={productionUrl}
            class="mt-5 inline-block rounded-panel border border-signal bg-signal/10 px-5 py-2.5 text-sm font-medium text-signal transition-colors hover:bg-signal/20"
          >
            Open the full version
          </a>
          <p class="mt-4 text-sm text-dim">
            or write directly:{' '}
            <a class="text-ink underline decoration-line underline-offset-4 hover:decoration-signal" href="mailto:dev.yurifpaulo@gmail.com">
              dev.yurifpaulo@gmail.com
            </a>
          </p>
        </div>
      ) : (
        <form method="POST" action={contactAction} id="contact-form" class="max-w-2xl">
          <div class="grid gap-5 sm:grid-cols-2">
            <label class="flex flex-col gap-2">
              <span class="text-sm text-dim">name</span>
              <input
                type="text"
                name="name"
                required
                minlength="2"
                autocomplete="name"
                class="rounded-panel border border-line bg-raised/60 px-3.5 py-2.5 text-ink placeholder:text-dim/50 focus:border-signal"
              />
            </label>
            <label class="flex flex-col gap-2">
              <span class="text-sm text-dim">e-mail</span>
              <input
                type="email"
                name="email"
                required
                autocomplete="email"
                class="rounded-panel border border-line bg-raised/60 px-3.5 py-2.5 text-ink placeholder:text-dim/50 focus:border-signal"
              />
            </label>
          </div>
          <label class="mt-5 flex flex-col gap-2">
            <span class="text-sm text-dim">message</span>
            <textarea
              name="message"
              required
              minlength="10"
              rows="5"
              class="resize-y rounded-panel border border-line bg-raised/60 px-3.5 py-2.5 text-ink placeholder:text-dim/50 focus:border-signal"
            />
          </label>

          <div class="hp-field" aria-hidden="true">
            <label>
              leave empty
              <input type="text" name="website" tabindex="-1" autocomplete="off" />
            </label>
          </div>

          <div class="mt-6 flex flex-wrap items-center gap-5">
            <button
              type="submit"
              class="rounded-panel border border-signal bg-signal/10 px-5 py-2.5 text-sm font-medium text-signal transition-colors hover:bg-signal/20 disabled:cursor-wait disabled:opacity-60"
            >
              send message
            </button>
            <p id="form-status" role="status" aria-live="polite" class="text-sm text-dim" />
          </div>
        </form>
      )
    }
  </div>
</section>

{
  !isStatic && (
    <script>
      import { actions } from 'astro:actions';

      const form = document.getElementById('contact-form') as HTMLFormElement | null;
      const status = document.getElementById('form-status');

      if (form && status) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
          if (button) button.disabled = true;
          status.classList.remove('text-signal');
          status.textContent = 'Sending…';

          try {
            const contact = actions.contact;
            if (!contact) {
              status.textContent =
                'Form backend unavailable here — e-mail dev.yurifpaulo@gmail.com directly.';
              return;
            }
            const result = await contact(new FormData(form));
            if (result.error) {
              // Runtime ActionError carries `fields`, but the astro:actions
              // type doesn't declare it — narrow locally instead of trusting it
              const fields = (result.error as { fields?: Record<string, string[]> }).fields ?? {};
              const fieldErrors = Object.entries(fields)
                .map(([field, messages]) => `${field}: ${messages.join(', ')}`)
                .join(' · ');
              status.textContent =
                fieldErrors || result.error.message || 'Something failed — e-mail dev.yurifpaulo@gmail.com directly.';
            } else {
              status.textContent = result.data?.message ?? 'Message sent.';
              status.classList.add('text-signal');
              form.reset();
            }
          } catch {
            status.textContent = 'Network failed — e-mail dev.yurifpaulo@gmail.com directly.';
          } finally {
            if (button) button.disabled = false;
          }
        });
      }
    </script>
  )
}
