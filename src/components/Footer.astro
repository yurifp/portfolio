---
import { site, socials } from '../data/site';

const year = new Date().getFullYear();
---
<footer class="relative border-t" style="border-color: var(--line-now);">
  <div class="px-[1.6rem] pt-[5rem] pb-[1.6rem]">
    <p class="mono-tiny text-dim mb-[1.4rem]" data-fade>Got an idea worth building?</p>

    <a
      href={`mailto:${site.email}`}
      class="display-section hover:text-lime transition-colors block leading-[0.9]"
      data-split="chars"
      data-cursor="SEND"
    >
      Shoot a<br />message
    </a>

    <a
      href={site.cv}
      download
      class="mono-tiny inline-block mt-[1.6rem] px-[0.8rem] py-[0.4rem] border nav-link"
      style="border-color: var(--line-now);"
      data-fade
    >
      ↓ Download CV
    </a>

    <div class="hairline-h my-[3.4rem]"></div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-[2.5rem] mb-[4rem]">
      {Object.entries(socials.footer).map(([group, links], gi) => (
        <div data-fade data-delay={0.1 + gi * 0.08}>
          <p class="mono-tiny text-faint mb-[0.8rem]">{group}</p>
          <ul class="space-y-[0.65rem]">
            {links.map((l) => (
              <li><a href={l.url} class="mono-tiny nav-link inline-block py-[0.45rem] min-h-[24px] box-border" style="color: var(--ink-now); letter-spacing: 0.32em;">{l.label.toUpperCase()}</a></li>
            ))}
          </ul>
        </div>
      ))}
      <div data-fade data-delay={0.3}>
        <p class="mono-tiny text-faint mb-[0.8rem]">Direct</p>
        <p class="mono-tiny" style="color: var(--ink-now);">{site.email}</p>
        <p class="mono-tiny mt-2 text-dim">{site.location.city}</p>
      </div>
    </div>

    <div class="flex flex-wrap items-center justify-between gap-3" data-fade data-delay={0.4}>
      <p class="mono-tiny text-faint">@{year} by {site.name}</p>
      <p class="mono-tiny text-faint">BUILT WITH ASTRO · GSAP · THREE.JS</p>
      <a href="#about" class="mono-tiny nav-link text-dim" data-scroll-top>Back to top ↑</a>
    </div>
  </div>
</footer>
