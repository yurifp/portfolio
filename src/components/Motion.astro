---
// Motion budget: one orchestrated moment (the hero power-on), one quiet batched
// reveal (project panels). Everything else moves in answer to user actions.
// Lenis + the single ticker live in src/experience/core.ts now — this file is
// pure DOM choreography on top of that foundation.
---

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { experience } from '../experience/core';
  import { getQuality, setQuality, type Quality } from '../experience/settings';

  gsap.registerPlugin(ScrollTrigger);

  // One shared ease vocabulary — mirrored from the CSS tokens in global.css
  const EASE = {
    settle: 'cubic-bezier(0.16, 1, 0.3, 1)',
    snap: 'cubic-bezier(0.83, 0, 0.17, 1)',
    glide: 'cubic-bezier(0.37, 0, 0.63, 1)',
  };

  experience.init();

  function initPage() {
    if (experience.reducedMotion) return; // static page, instant states

    const headline = document.querySelector('[data-hero-head]');
    const readouts = gsap.utils.toArray<HTMLElement>('[data-readout]');

    if (headline) {
      gsap.from(headline, { autoAlpha: 0, y: 24, duration: 0.9, ease: EASE.settle });
    }

    if (readouts.length) {
      gsap.set(readouts, { y: 14 });
      ScrollTrigger.batch(readouts, {
        start: 'top 95%',
        once: true,
        onEnter: (batch) =>
          gsap.to(batch, { autoAlpha: 1, y: 0, duration: 0.7, ease: EASE.settle, stagger: 0.12 }),
      });
    }

    // Elements inside astro-islands are animated by the island itself after
    // hydration — touching them here would corrupt React's hydration diff
    const reveals = gsap.utils
      .toArray<HTMLElement>('[data-reveal]')
      .filter((el) => !el.closest('astro-island'));
    if (reveals.length) {
      gsap.set(reveals, { y: 18 });
      ScrollTrigger.batch(reveals, {
        start: 'top 92%',
        once: true,
        onEnter: (batch) =>
          gsap.to(batch, { autoAlpha: 1, y: 0, duration: 0.6, ease: EASE.settle, stagger: 0.08 }),
      });
    }

    ScrollTrigger.refresh();
  }

  document.addEventListener('astro:page-load', initPage);
  document.addEventListener('astro:before-swap', () => {
    ScrollTrigger.getAll().forEach((trigger) => trigger.kill());
  });

  // ── Settings panel ─────────────────────────────────────────────────────────
  function initSettings() {
    const btn = document.getElementById('settings-btn');
    const panel = document.getElementById('settings-panel');
    if (!btn || !panel) return;

    const opts = [...panel.querySelectorAll<HTMLButtonElement>('.opt')];

    function render(current: Quality) {
      opts.forEach((o) => o.setAttribute('aria-pressed', String(o.dataset.quality === current)));
    }
    render(getQuality());

    btn.addEventListener('click', () => {
      const open = panel.dataset.open !== 'true';
      panel.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
    });

    opts.forEach((o) =>
      o.addEventListener('click', () => {
        const q = o.dataset.quality as Quality;
        setQuality(q);
        render(q);
      }),
    );
  }
  // astro:page-load fires on the FIRST load too — registering only via the
  // event keeps init idempotent (a top-level call would double-attach
  // listeners: the click would open AND close the panel in one event).
  document.addEventListener('astro:page-load', initSettings);
</script>
