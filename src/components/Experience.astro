---
// From Yuri_Resume_EN.docx (NOVO RESUME, 2026-09-18) — plain server-rendered
// rows, no animation gates: if anything downstream fails, this still shows.
const jobs = [
  {
    role: 'Front-End Engineer II',
    org: 'SENAI CIMATEC · Salvador, BA',
    when: 'AUG 2023 — PRESENT',
    points: [
      'Scalable component libraries and standardized workflows across modern (React, Next.js, TypeScript) and legacy (JavaScript, jQuery) stacks, accelerating delivery across concurrent educational and technology initiatives',
      'Architecture that increased engineering productivity 10× through reusable components and standard workflows — reactive interfaces with rigorous load-performance focus and full WCAG 2.1 compliance',
      'Led REST API and third-party integrations inside distributed architectures; secure, reliable data communication across production systems',
      'High-fidelity Figma prototypes translated into pixel-accurate, production-ready interfaces with UI/UX designers, back-end engineers and business stakeholders in Scrum ceremonies',
      'Code reviews across React/Next.js and legacy codebases; championed Jest + React Testing Library, cutting regression defects and strengthening CI/CD release confidence',
    ],
  },
  {
    role: 'Front-End Engineer I',
    org: 'SENAI CIMATEC · Salvador, BA',
    when: 'JUL 2022 — APR 2023',
    points: [
      'Developed and evolved 170+ institutional websites and e-learning platforms for a large, multi-stakeholder user base',
      'Mobile-first responsive interfaces with HTML5, CSS3, JavaScript, jQuery and Bootstrap — consistent usability across desktop and mobile',
      'Front-end performance optimization (load and render) and cross-browser compatibility',
      'Multidisciplinary Agile team with Git-based version control: code reviews, bug resolution, continuous quality improvement',
    ],
  },
  {
    role: 'Full Stack Freelance Developer',
    org: 'Brazil · remote',
    when: 'JUL 2020 — MAY 2022',
    points: [
      'Modern web applications end-to-end with JavaScript, React, C#, TypeScript, Node.js and Figma',
      'Responsive interfaces with strong UI/UX, performance and scalability focus',
      'Interactive and visually engaging web experiences, including 3D interfaces with Three.js',
    ],
  },
];
---

<section id="experience" aria-labelledby="experience-title" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-4">
      <h2 id="experience-title" class="display section-title">Experience</h2>
      <p class="text-sm text-dim">six years · SENAI CIMATEC + freelance</p>
    </div>

    <div class="exp-list">
      {
        jobs.map((job, i) => (
          <article class="exp-row">
            <div>
              <span class="exp-idx">0{i + 1}</span>
              <h3 class="exp-role">{job.role}</h3>
              <p class="exp-org">{job.org}</p>
            </div>
            <ul>
              {job.points.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
            <span class="exp-when">{job.when}</span>
          </article>
        ))
      }
    </div>
  </div>
</section>
