---
// Groups reflect the actual split of Yuri's work, cross-checked against his
// GitHub (github.com/yurifp): front-end sites/apps, back-end services,
// full-stack freelance deliveries + this very site, AI/agent experiments
// (IA-Agent, flappybird AI), blockchain TCC (block-office).
const groups = [
  {
    role: 'front-end',
    items: ['React', 'Next.js', 'TypeScript', 'Vue.js', 'Tailwind CSS', 'Three.js', 'GSAP', 'Micro Frontends / Single-SPA'],
  },
  {
    role: 'back-end',
    items: ['Node.js', 'C# / .NET', 'Java', 'Python', 'REST API design', 'Redis', 'MySQL'],
  },
  {
    role: 'full-stack',
    items: ['Astro (SSR, Actions, islands)', 'CI/CD GitHub Actions', 'Freelance apps delivered end-to-end (React + C#/Node)', 'This site — one codebase, two deploy targets'],
  },
  {
    role: 'ia',
    items: ['LLMs', 'AI agents', 'Multi-agent systems', 'RAG', 'MCP', 'YOLO computer vision (GlobeExplorers)', 'VPS inference infrastructure'],
  },
  {
    role: 'blockchain',
    items: ['Solidity', 'Ethereum', 'Solana', 'Smart-contract data systems (TCC, 10/10)'],
  },
  {
    role: 'operation',
    items: ['Docker', 'Azure', 'OpenShift', 'Jest + React Testing Library', 'WCAG 2.1', 'Figma'],
  },
];
---

<section id="stack" aria-labelledby="stack-title" class="border-b border-line">
  <div class="mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-2 border-b border-line pb-4">
      <h2 id="stack-title" class="text-2xl font-semibold tracking-tight">Stack</h2>
      <p class="text-sm text-dim">grouped by how the work actually splits</p>
    </div>

    <dl class="divide-y divide-line">
      {
        groups.map((group) => (
          <div class="grid gap-2 py-5 sm:grid-cols-[10rem_1fr] sm:gap-6">
            <dt class="text-sm text-dim">{group.role}</dt>
            <dd class="flex flex-wrap gap-x-5 gap-y-1 text-ink">
              {group.items.map((item) => (
                <span class="text-sm">{item}</span>
              ))}
            </dd>
          </div>
        ))
      }
    </dl>
  </div>
</section>
